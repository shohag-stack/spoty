---
import { NewsletterForm } from "@/components/islands/NewsletterForm";
import { getSiteSettings } from "@/fetch/siteSettings";
import { isExternal } from "@/lib/utils";

const settings = await getSiteSettings();
---

{
  settings && (
    <footer class="mt-20 bg-canvas pb-10 md:mt-21">
      <div class="mx-auto max-w-site px-4 md:px-8 lg:px-13">
        <div class="grid gap-14 lg:grid-cols-[424fr_766fr] lg:gap-36">
          <div class="max-w-101">
            {settings.newsletterHeading && <h2 class="mb-6 text-3xl md:text-title">{settings.newsletterHeading}</h2>}
            <NewsletterForm
              client:visible
              placeholder={settings.newsletterPlaceholder ?? "Your email address"}
              buttonLabel={settings.newsletterButton ?? "Subscribe"}
            />
          </div>

          <div class="lg:pt-2.5">
            <div class="grid grid-cols-2 gap-8 sm:flex sm:gap-0">
              {settings.footerColumns?.map((column) => (
                <ul class="space-y-1 sm:w-57">
                  {column.links?.map(
                    (link) =>
                      link.href && (
                        <li>
                          <a
                            href={link.href}
                            class="hover:underline"
                            {...(isExternal(link.href) && { target: "_blank", rel: "noopener noreferrer" })}
                          >
                            {link.label}
                          </a>
                        </li>
                      )
                  )}
                </ul>
              ))}
            </div>
            {settings.contactEmail && (
              <p class="mt-10">
                Contact:{" "}
                <a href={`mailto:${settings.contactEmail}`} class="hover:underline">
                  {settings.contactEmail}
                </a>
              </p>
            )}
          </div>
        </div>

        {settings.copyright && <p class="mt-21 text-center">{settings.copyright}</p>}
      </div>
    </footer>
  )
}

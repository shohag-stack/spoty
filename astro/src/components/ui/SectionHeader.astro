---
import { cn } from "@/lib/utils";

type Props = { heading: string; text?: string; class?: string };

// Heading on the left, intro text (or anything in the "aside" slot) on the right — used by most sections.
const { heading, text, class: className } = Astro.props;
const hasAside = Astro.slots.has("aside");
---

<div class={cn("grid gap-6 md:grid-cols-2 md:items-end md:gap-16", className)}>
  <h2 class="max-w-xl text-4xl font-medium text-balance md:text-5xl lg:text-heading">{heading}</h2>
  {
    (text || hasAside) && (
      <div class="max-w-md md:justify-self-end">
        {text && <p class="text-base leading-relaxed text-muted">{text}</p>}
        <slot name="aside" />
      </div>
    )
  }
</div>

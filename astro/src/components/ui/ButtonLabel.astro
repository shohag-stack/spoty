---
import { buttonLabelRow } from "@/lib/button";
import { cn } from "@/lib/utils";

// On hover the label rolls up and an identical copy rolls in from below.
const html = await Astro.slots.render("default");
---

<span class="relative block overflow-hidden">
  <span class={cn(buttonLabelRow, "group-hover/btn:-translate-y-full")} set:html={html} />
  <span aria-hidden="true" class={cn(buttonLabelRow, "absolute inset-0 translate-y-full group-hover/btn:translate-y-0")} set:html={html} />
</span>

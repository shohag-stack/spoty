---
import Reveal from "@/components/animation/Reveal.astro";
import Button from "@/components/ui/Button.astro";
import CoachCard from "@/components/ui/CoachCard.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import type { CoachCardData, CoachesSectionData } from "@/types";

type Props = CoachesSectionData;

const { heading, text, coaches, button } = Astro.props;
const items = coaches.filter((c): c is CoachCardData => Boolean(c?.slug));
---

<section class="my-20 md:my-35">
  <div class="mx-auto max-w-site px-4 md:px-8 lg:px-13">
    <Reveal>
      <SectionHeader heading={heading} text={text} />
    </Reveal>
    <Reveal stagger class="mt-12 grid grid-cols-2 gap-3 md:mt-16 md:gap-5 lg:grid-cols-4">
      {items.map((coach) => <CoachCard coach={coach} sizes="(min-width: 1024px) 25vw, 50vw" />)}
    </Reveal>
    {
      button?.href && (
        <div class="mt-12 flex justify-center">
          <Button link={button} />
        </div>
      )
    }
  </div>
</section>

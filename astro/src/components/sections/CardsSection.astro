---
import Reveal from "@/components/animation/Reveal.astro";
import Spotlight from "@/components/animation/Spotlight.astro";
import Icon from "@/components/icons/Icon.astro";
import Button from "@/components/ui/Button.astro";
import SanityImage from "@/components/ui/SanityImage.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { hasImage } from "@/lib/image";
import { cn } from "@/lib/utils";
import type { CardsSectionData } from "@/types";

type Props = CardsSectionData;

const COLUMNS = {
  2: "md:grid-cols-2",
  3: "md:grid-cols-2 lg:grid-cols-3",
  4: "sm:grid-cols-2 lg:grid-cols-4",
};

const { heading, text, cards, columns = 3 } = Astro.props;
---

<section class="my-20 md:my-35">
  <div class="mx-auto max-w-site px-4 md:px-8 lg:px-13">
    <Reveal>
      <SectionHeader heading={heading} text={text} />
    </Reveal>
    <Reveal stagger class={cn("mt-12 grid gap-4 md:mt-16 md:gap-5", COLUMNS[columns])}>
      {
        cards?.map((card) => {
          const withImage = hasImage(card.image);
          return (
            <div>
              <Spotlight class="h-full rounded-card bg-white transition-[transform,box-shadow] duration-500 ease-out-expo hover:-translate-y-1.5 hover:shadow-xl hover:shadow-black/5">
                <article class="group flex h-full flex-col p-2.5">
                  {withImage && (
                    <div class="relative aspect-4/3 overflow-hidden rounded-card">
                      <SanityImage
                        image={card.image}
                        sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                        class="transition-transform duration-700 group-hover:scale-105"
                      />
                    </div>
                  )}
                  <div class={cn("flex flex-1 flex-col", withImage ? "p-5 md:p-6" : "p-6 md:p-8")}>
                    {card.label && <p class={cn("text-subtle", withImage ? "text-sm" : "mb-10 text-5xl")}>{card.label}</p>}
                    <h3 class="mt-1 text-2xl">{card.title}</h3>
                    {card.text && <p class="mt-3 leading-relaxed text-muted">{card.text}</p>}
                    {card.link?.href && (
                      <div class="mt-auto pt-6">
                        <Button link={card.link} variant="outline-dark" size="sm">
                          {card.link.label}
                          <Icon name="arrow-up-right" class="size-4" />
                        </Button>
                      </div>
                    )}
                  </div>
                </article>
              </Spotlight>
            </div>
          );
        })
      }
    </Reveal>
  </div>
</section>

{
  "name": "spoty",
  "version": "1.1.1",
  "description": "A premium sportsman portfolio website template built with Next.js & Sanity CMS",
  "author": "rayso.studio",
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:studio": "cd studio && npm run dev",
    "build": "cd frontend && npm run build",
    "seed": "node scripts/seed.mjs",
    "deploy:studio": "cd studio && sanity deploy",
    "deploy:schema": "cd studio && sanity manifest extract && sanity schema deploy",
    "zip": "bash zip.sh",
    "astro:dev": "npm-run-all --parallel astro:dev:* dev:studio",
    "astro:dev:site": "cd astro && npm run dev",
    "astro:build": "cd astro && npm run build"
  },
  "workspaces": [
    "frontend",
    "astro",
    "studio"
  ],
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "private": true,
  "license": "SEE LICENSE IN LICENSE.txt",
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
